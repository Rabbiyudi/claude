# Rimon CRM Environment Variables

# Claude API (Anthropic) - Required for AI-powered text analysis
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Google Calendar API
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=

# Optional: WhatsApp Cloud API
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# Optional: Airtable
# AIRTABLE_API_KEY=
# AIRTABLE_BASE_ID=

# Optional: Twilio for SMS
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# Chabad Scraper - Email Settings
# For Gmail: use an App Password from https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SEND_TO=recipient@email.com
