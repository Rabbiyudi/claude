# Chabad House Website - Environment Variables

# Optional: Stripe for payments
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# Optional: Email service (SendGrid, Resend, etc.)
# EMAIL_API_KEY=
# EMAIL_FROM=noreply@chabad-house.org.il

# Optional: Database URL (when using a real database)
# DATABASE_URL=

# Optional: Admin password (change in production!)
# ADMIN_PASSWORD=your_secure_password_here
